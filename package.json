{
  "name": "memebot",
  "productName": "MemeBot",
  "version": "0.4.0",
  "description": "Telegram ve X sinyallerinden GMGN üzerinden meme coin alım-satımı yapan uygulama (masaüstü + web + motor)",
  "main": "./out/main/index.js",
  "author": "FakeLord",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "build:web": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.web.config.mts",
    "dev:web": "vite --config vite.web.config.mts",
    "test": "vitest run",
    "engine": "node --env-file=.env.engine out/main/engine.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
